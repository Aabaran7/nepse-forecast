# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# .env is for LOCAL runs only. The daily job on GitHub reads the same names from
# repository secrets, not from this file -- nothing here is ever uploaded.

# Used by scripts/score_sentiment.py to read headlines and rate them.
# Only needed if you run the sentiment step yourself; every other script works
# without it.
OPENAI_API_KEY=
